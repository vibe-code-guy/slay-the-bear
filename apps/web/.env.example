# Copy to .env.local (gitignored) or set in your host's secret settings.
# scripts/web-env.ts writes a complete .env.local from ~/.near-credentials.

# Public (baked into the page). Leave NEXT_PUBLIC_GAME_ID unset to use the public town,
# or set it to "" for an offline-only build.
NEXT_PUBLIC_GAME_ID=game.slaythebear.testnet
NEXT_PUBLIC_ROOT_ACCOUNT=slaythebear.testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com

# Server only. The relayer creates guest accounts under NEXT_PUBLIC_ROOT_ACCOUNT and pays the
# gas of their moves, so it must be that root account.
RELAYER_ACCOUNT_ID=slaythebear.testnet
RELAYER_PRIVATE_KEY=ed25519:...
# Optional helpers: the keeper settles finished raids; villagers are NPC raiders.
KEEPER_ACCOUNT_ID=keeper.slaythebear.testnet
KEEPER_PRIVATE_KEY=ed25519:...
VILLAGER_KEYS={"bjorn.slaythebear.testnet":"ed25519:..."}
GUEST_FUND_NEAR=0.01
